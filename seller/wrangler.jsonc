{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enma",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SELLER_DO",
        "class_name": "SellerDO"
      },
      {
        "name": "EVENT_HUB",
        "class_name": "EventHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SellerDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EventHub"]
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
