# ============================================================================
# seller/ — the Cloudflare Worker + Durable Object (Phase 2)
# These become `wrangler secret put <NAME>` entries once the Worker exists —
# Cloudflare Workers don't read a plain .env file at runtime the way Node
# does. This file is where YOU collect the values first; Phase 2's setup
# step copies each one into Wrangler with one command per line, shown in
# PHASE0_SETUP.md.
# ============================================================================

# --- Anthropic (Phase 0, step 3) --------------------------------------------
# console.anthropic.com → API Keys → Create Key. Starts with sk-ant-
ANTHROPIC_API_KEY=

# --- Cloudflare AI Gateway (Phase 0, step 2) --------------------------------
# Your Cloudflare account ID (dashboard right sidebar, any page) and the
# AI Gateway name you create (PHASE0_SETUP.md has you name it "enma").
CF_ACCOUNT_ID=
CF_AI_GATEWAY_NAME=enma
# Full URL is assembled from the two above as:
#   https://gateway.ai.cloudflare.com/v1/<CF_ACCOUNT_ID>/<CF_AI_GATEWAY_NAME>/anthropic

# --- the seller's own on-chain identity (Phase 0, step 5) -------------------
# Two MORE wallets, separate from the buyer's OWNER/AGENT/GUARDIAN above.
# Generate with: cast wallet new (run it twice)

# The "real" (honest) seller — receives payment, needs a little ETH for gas
# if you ever call claimWithSignature yourself instead of via the facilitator.
ENMA_RECEIVER_PRIVATE_KEY=
ENMA_RECEIVER_ADDRESS=
ENMA_AUTHORIZER_PRIVATE_KEY=
ENMA_AUTHORIZER_ADDRESS=

# The "rogue" seller instance used for the demo's Save/Revert beats — a
# SEPARATE receiver so revoking it never touches the honest seller's money.
ROGUE_RECEIVER_PRIVATE_KEY=
ROGUE_RECEIVER_ADDRESS=
ROGUE_AUTHORIZER_PRIVATE_KEY=
ROGUE_AUTHORIZER_ADDRESS=

# --- deployed contract addresses (filled in after Phase 1's deploy) --------
ENMA_GUARD_ADDRESS=
ENMA_COLLECTOR_ADDRESS=

# --- your dedicated RPC (same one from contracts/.env.example) -------------
RPC_URL=

# --- Ops narrator (Phase 4) ---------------------------------------------------
# See docs/PLAN.md §13: seller events (revokes/incidents, bans, successful claims) post
# directly to this Slack Incoming Webhook for #enma-ops. Slack app → Incoming Webhooks →
# Activate → Add New Webhook to Workspace → pick the channel.
SLACK_OPS_WEBHOOK_URL=

# --- admin/ops -----------------------------------------------------------
# A password you make up yourself, used to hit POST /admin/claim by hand
# during rehearsal/demo. Any long random string is fine.
ADMIN_TOKEN=

# --- network switch (see PLAN.md §4) ----------------------------------------
ENMA_NETWORK=testnet

# --- rogue demo mode (Phase 2, step 2.8) ------------------------------------
# Unset/0 = always honest. Set to N to serve junk starting on call N+1 per asset —
# used to drive the demo's "rogue seller" Save/Revert beats.
ROGUE_AFTER=
