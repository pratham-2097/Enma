# ============================================================================
# contracts/ — used by Foundry (forge, cast, the deploy script)
# Read in exactly one place: contracts/script/Deploy.s.sol and any `cast`
# command you run by hand.
#
# HOW TO FILL THIS IN: see PHASE0_SETUP.md, step by step. Short version:
# generate 3 wallets with `cast wallet new`, fund 2 of them from faucets,
# get an RPC URL from Alchemy or QuickNode.
# ============================================================================

# --- your dedicated Base Sepolia RPC (Phase 0, step 4) ---------------------
# From alchemy.com or quicknode.com, a free account, a Base Sepolia app.
# Do NOT use the public https://sepolia.base.org — it rate-limits hard.
RPC_URL=

# --- the three EVM keys Phase 0 asks for, buyer side ------------------------
# Generate each with: cast wallet new
# That prints an Address and a Private key. Paste ONLY the private key here
# (starts with 0x, 64 hex characters after that). Never share these, never
# commit this file (it's already gitignored).

# OWNER — controls the EnmaGuard wallet contract. Holds test USDC + ETH.
OWNER_PRIVATE_KEY=
OWNER_ADDRESS=

# AGENT — signs vouchers on the buyer's behalf. Needs a small amount of ETH.
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# GUARDIAN — the only key allowed to call revoke()/restore(). Needs ETH too.
GUARDIAN_PRIVATE_KEY=
GUARDIAN_ADDRESS=

# --- deployed contract addresses (filled in AFTER you deploy, Phase 1) -----
ENMA_GUARD_ADDRESS=
ENMA_COLLECTOR_ADDRESS=

# --- fixed, already-verified addresses — do not change these ---------------
ESCROW_ADDRESS=0x4020074e9dF2ce1deE5A9C1b5c3f541D02a10003
USDC_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_MAINNET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
