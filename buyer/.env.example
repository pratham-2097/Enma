# ============================================================================
# buyer/ — the local Node CLI (and later the MCP server) that pays Enma
# This one IS a real, plain .env file, read with `dotenv` at process start,
# since the buyer runs on your laptop, not on Cloudflare.
# ============================================================================

# --- the three EVM keys, same values as contracts/.env.example -------------
# Copy them over once you've generated them there — same wallets, same job:
# OWNER opens tabs on EnmaGuard, AGENT signs vouchers, GUARDIAN revokes.
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
GUARDIAN_PRIVATE_KEY=

# --- deployed contract address (filled in after Phase 1's deploy) ----------
ENMA_GUARD_ADDRESS=

# --- seller receiver addresses (same values as seller/.env.example, needed --
# by scripts/restoreSellers.ts to reset the shared testnet fixture) ---------
ENMA_RECEIVER_ADDRESS=
ROGUE_RECEIVER_ADDRESS=

# --- your dedicated RPC (same one everywhere) -------------------------------
RPC_URL=

# --- the seller's URL (filled in after Phase 2 deploys the Worker) ---------
SELLER_URL=https://enma.<your-subdomain>.workers.dev

# --- Jev (Phase 0, step 9 — you're supplying this key yourself) ------------
TYPESAFE_API_KEY=
# Fallback provider, only needed if the TypeSafe key stops working:
AIMLAPI_KEY=

# --- Intercepta (optional, D5 — skip unless you get a key later) -----------
INTERCEPTA_API_KEY=

# --- shady-seller denylist (D5, PLAN.md §16 beat 6) -------------------------
# Comma-separated payTo addresses `agent.ts shady` refuses before ever signing
# a voucher. For the demo, this is the rogue seller's own receiver address.
FLAGGED_SELLERS=

# --- admin token (matches seller/.env's ADMIN_TOKEN, PLAN.md §16 beat 5) ---
# Used by scripts/runDemo.ts to POST /admin/reset-ledger after each MAD-ban
# rehearsal, so the seller's shared ban ledger doesn't block the next run.
ADMIN_TOKEN=

# --- network switch (see PLAN.md §4) ----------------------------------------
ENMA_NETWORK=testnet

# --- spend limit firewall (optional demo mode) ------------------------------
# `buyer firewall <asset>` refuses to open a channel if the seller's quoted price
# exceeds this cap (in USDC, e.g. 0.005), checked BEFORE any gas is spent. Unset =
# no cap in firewall mode (same as buy). Ignored by buy/cheat/shady.
MAX_PER_CALL_USDC=
